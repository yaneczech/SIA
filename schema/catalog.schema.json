{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/yaneczech/SIA/schema/v0.4/catalog.schema.json",
  "title": "SIA Catalog Manifest",
  "type": "object",
  "required": ["spec_version", "profile_id", "profile_version", "catalog_version", "generated_at_ms", "nodes"],
  "properties": {
    "spec_version": { "const": "0.4.0" },
    "profile_id": { "const": "sia-minimal" },
    "profile_version": { "$ref": "#/$defs/semver" },
    "catalog_version": { "$ref": "#/$defs/semver" },
    "generated_at_ms": { "type": "integer", "minimum": 0 },
    "nodes": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "https://github.com/yaneczech/SIA/schema/v0.4/interaction-node.schema.json" }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "semver": { "type": "string", "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z.-]+)?$" }
  }
}
