{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/yaneczech/SIA/schema/v0.4/context-snapshot.schema.json",
  "title": "SIA Context Snapshot",
  "type": "object",
  "required": ["context_id", "captured_at_ms", "policy_version", "axes", "integrity"],
  "properties": {
    "context_id": { "$ref": "#/$defs/uuid" },
    "captured_at_ms": { "type": "integer", "minimum": 0 },
    "policy_version": { "$ref": "#/$defs/semver" },
    "axes": {
      "type": "object",
      "required": ["vehicle_state", "road_type", "driver_state"],
      "properties": {
        "vehicle_state": { "$ref": "#/$defs/vehicleAxis" },
        "road_type": { "$ref": "#/$defs/roadAxis" },
        "driver_state": { "$ref": "#/$defs/driverAxis" }
      },
      "additionalProperties": false
    },
    "integrity": { "$ref": "#/$defs/integrity" }
  },
  "additionalProperties": false,
  "$defs": {
    "semver": { "type": "string", "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z.-]+)?$" },
    "uuid": { "type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-8][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$" },
    "baseAxis": {
      "type": "object",
      "required": ["source_id", "observed_at_ms", "confidence"],
      "properties": {
        "source_id": { "type": "string", "minLength": 1, "maxLength": 200 },
        "observed_at_ms": { "type": "integer", "minimum": 0 },
        "confidence": { "type": "integer", "minimum": 0, "maximum": 100 }
      }
    },
    "vehicleAxis": {
      "type": "object",
      "allOf": [
        { "$ref": "#/$defs/baseAxis" },
        { "type": "object", "required": ["value"], "properties": { "value": { "enum": ["moving", "parked", "charging", "service", "unknown"] } } }
      ],
      "unevaluatedProperties": false
    },
    "roadAxis": {
      "type": "object",
      "allOf": [
        { "$ref": "#/$defs/baseAxis" },
        { "type": "object", "required": ["value"], "properties": { "value": { "enum": ["urban", "rural", "highway", "off_road", "unknown"] } } }
      ],
      "unevaluatedProperties": false
    },
    "driverAxis": {
      "type": "object",
      "allOf": [
        { "$ref": "#/$defs/baseAxis" },
        { "type": "object", "required": ["value"], "properties": { "value": { "enum": ["attentive", "drowsy", "distracted", "not_monitoring", "unknown"] } } }
      ],
      "unevaluatedProperties": false
    },
    "integrity": {
      "type": "object",
      "required": ["key_id", "algorithm", "signature"],
      "properties": {
        "key_id": { "type": "string", "minLength": 1, "maxLength": 200 },
        "algorithm": { "enum": ["ES256", "EdDSA", "HMAC-SHA-256"] },
        "signature": { "type": "string", "pattern": "^[A-Za-z0-9_-]+$", "minLength": 8, "maxLength": 4096 }
      },
      "additionalProperties": false
    }
  }
}
