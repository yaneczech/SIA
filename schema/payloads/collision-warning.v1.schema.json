{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/yaneczech/SIA/schema/v0.4.0/payloads/collision-warning.v1.schema.json",
  "title": "Payload: Interaction.Event.Alert.Collision.Warning (sia:payload:collision-warning:1)",
  "type": "object",
  "required": ["time_to_collision_s", "threat_bearing_deg", "threat_range_m", "relative_speed_kmh"],
  "properties": {
    "time_to_collision_s": { "type": "number", "exclusiveMinimum": 0, "maximum": 30 },
    "threat_bearing_deg": { "type": "number", "minimum": -180, "maximum": 180 },
    "threat_range_m": { "type": "number", "minimum": 0, "maximum": 500 },
    "relative_speed_kmh": { "type": "number", "minimum": 0, "maximum": 400 }
  },
  "additionalProperties": false
}
