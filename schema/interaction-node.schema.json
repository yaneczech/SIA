{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/yaneczech/SIA/schema/v0.4.0/interaction-node.schema.json",
  "title": "SIA Interaction Node Declaration",
  "description": "Normative Alert and Notification declaration contract for SIA v0.4.0. Action, State, and Task require a future profile. Runtime instances use runtime-instance.schema.json.",
  "oneOf": [
    { "$ref": "#/$defs/alert" },
    { "$ref": "#/$defs/notification" }
  ],
  "$defs": {
    "semver": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z.-]+)?$"
    },
    "nodeId": {
      "type": "string",
      "pattern": "^Interaction\\.Event\\.(Alert|Notification)(\\.[A-Z][A-Za-z0-9_]*)+$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "attentionMetrics": {
      "type": "object",
      "required": [
        "glance_time_estimated_ms",
        "mean_single_glance_ms",
        "task_steps",
        "voice_alt_available",
        "cognitive_load"
      ],
      "properties": {
        "glance_time_estimated_ms": { "type": "integer", "minimum": 0, "maximum": 60000 },
        "mean_single_glance_ms": { "type": "integer", "minimum": 0, "maximum": 60000 },
        "task_steps": { "type": "integer", "minimum": 0, "maximum": 100 },
        "voice_alt_available": { "type": "boolean" },
        "cognitive_load": { "enum": ["minimal", "moderate", "high", "locked_while_driving"] }
      },
      "additionalProperties": false
    },
    "trustRequirements": {
      "type": "object",
      "required": [
        "signed_origin_required",
        "permitted_actor_classes",
        "max_ingress_age_ms",
        "replay_protection",
        "session_revocation_required"
      ],
      "properties": {
        "signed_origin_required": { "const": true },
        "permitted_actor_classes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "enum": ["human_direct", "adas", "service", "third_party_app", "agent_local", "agent_cloud"] }
        },
        "max_ingress_age_ms": { "type": "integer", "minimum": 1, "maximum": 86400000 },
        "replay_protection": { "const": "required" },
        "session_revocation_required": { "type": "boolean" }
      },
      "additionalProperties": false
    },
    "blockedPolicy": {
      "oneOf": [
        {
          "type": "object",
          "required": ["disposition"],
          "properties": { "disposition": { "const": "never_block" } },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["disposition", "audit_required"],
          "properties": {
            "disposition": { "const": "drop" },
            "audit_required": { "const": true }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["disposition", "ttl_ms", "reevaluate_on", "on_expiry", "max_pending"],
          "properties": {
            "disposition": { "const": "defer" },
            "ttl_ms": { "type": "integer", "minimum": 1, "maximum": 86400000 },
            "reevaluate_on": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": { "enum": ["motion_state_change", "operating_mode_change", "energy_state_change", "road_type_change", "driver_state_change", "occupancy_change", "policy_change"] }
            },
            "on_expiry": { "const": "drop" },
            "max_pending": { "type": "integer", "minimum": 1, "maximum": 100 }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["disposition", "ttl_ms", "coalescing_key_fields", "reevaluate_on", "on_expiry", "max_pending_per_key"],
          "properties": {
            "disposition": { "const": "coalesce" },
            "ttl_ms": { "type": "integer", "minimum": 1, "maximum": 86400000 },
            "coalescing_key_fields": {
              "type": "array",
              "minItems": 1,
              "maxItems": 8,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "pattern": "^(node_id|target_role|actor_id|payload\\.[a-z][a-z0-9_]*)$"
              }
            },
            "reevaluate_on": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": { "enum": ["motion_state_change", "operating_mode_change", "energy_state_change", "road_type_change", "driver_state_change", "occupancy_change", "policy_change"] }
            },
            "on_expiry": { "const": "drop" },
            "max_pending_per_key": { "const": 1 }
          },
          "additionalProperties": false
        }
      ]
    },
    "contextPolicy": {
      "type": "object",
      "required": ["policy_ref", "policy_sha256", "applicability", "unknown_context", "on_blocked"],
      "properties": {
        "applicability": { "enum": ["always", "moving_only", "profile_defined"] },
        "policy_ref": { "type": "string", "pattern": "^sia:policy:[a-z0-9_.-]+:[0-9]+$" },
        "policy_sha256": { "$ref": "#/$defs/sha256" },
        "unknown_context": { "enum": ["safe_worst_case", "fail_closed"] },
        "on_blocked": { "$ref": "#/$defs/blockedPolicy" }
      },
      "additionalProperties": false
    },
    "presentationContract": {
      "type": "object",
      "required": [
        "preferred_renderers",
        "required_renderers",
        "delivery_success_policy",
        "delivery_timeout_ms",
        "degradation_policy"
      ],
      "properties": {
        "preferred_renderers": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "enum": ["cluster", "ivi", "voice"] }
        },
        "required_renderers": {
          "type": "array",
          "uniqueItems": true,
          "items": { "enum": ["cluster", "ivi", "voice"] }
        },
        "delivery_success_policy": { "enum": ["any_selected_presented", "primary_presented", "all_required_presented"] },
        "delivery_timeout_ms": { "type": "integer", "minimum": 1, "maximum": 60000 },
        "degradation_policy": { "enum": ["next_eligible", "no_degradation", "drop_with_audit"] }
      },
      "allOf": [
        {
          "if": { "properties": { "delivery_success_policy": { "const": "all_required_presented" } }, "required": ["delivery_success_policy"] },
          "then": { "properties": { "required_renderers": { "type": "array", "minItems": 1 } } }
        }
      ],
      "additionalProperties": false
    },
    "occupantResponse": {
      "oneOf": [
        {
          "type": "object",
          "required": ["kind"],
          "properties": { "kind": { "const": "none" } },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["kind", "authority", "timeout_ms"],
          "properties": {
            "kind": { "const": "explicit_or_timeout" },
            "authority": { "enum": ["driver_only", "any_occupant"] },
            "timeout_ms": { "type": "integer", "minimum": 1, "maximum": 600000 }
          },
          "additionalProperties": false
        }
      ]
    },
    "commonEvent": {
      "type": "object",
      "required": [
        "id",
        "inherits_from",
        "since_version",
        "direction",
        "target_role",
        "temporal_type",
        "priority",
        "interruptibility",
        "semantic_validity_ms",
        "payload_schema_ref",
        "payload_schema_sha256",
        "trust_requirements",
        "attention_metrics",
        "context_policy",
        "presentation_contract",
        "occupant_response",
        "pii_class"
      ],
      "properties": {
        "id": { "$ref": "#/$defs/nodeId" },
        "inherits_from": { "enum": ["Interaction.Event.Alert", "Interaction.Event.Notification"] },
        "since_version": { "$ref": "#/$defs/semver" },
        "deprecated_since": { "$ref": "#/$defs/semver" },
        "replaced_by": { "$ref": "#/$defs/nodeId" },
        "direction": { "const": "system_to_occupant" },
        "target_role": { "enum": ["driver", "front_passenger", "rear_passenger", "any_occupant"] },
        "temporal_type": { "const": "discrete" },
        "priority": { "enum": ["critical", "high", "normal", "low", "background"] },
        "interruptibility": { "enum": ["non_interruptible", "interruptible", "deferable"] },
        "semantic_validity_ms": { "type": "integer", "minimum": 1, "maximum": 86400000 },
        "payload_schema_ref": { "type": "string", "minLength": 1, "maxLength": 500 },
        "payload_schema_sha256": { "$ref": "#/$defs/sha256" },
        "trust_requirements": { "$ref": "#/$defs/trustRequirements" },
        "attention_metrics": { "$ref": "#/$defs/attentionMetrics" },
        "context_policy": { "$ref": "#/$defs/contextPolicy" },
        "presentation_contract": { "$ref": "#/$defs/presentationContract" },
        "occupant_response": { "$ref": "#/$defs/occupantResponse" },
        "pii_class": { "enum": ["none", "personal", "sensitive", "special_category"] },
        "accessibility_alternatives": {
          "type": "array",
          "uniqueItems": true,
          "items": { "enum": ["visual", "auditory", "haptic"] }
        },
        "regulatory_basis": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
        "assessment_basis": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } }
      }
    },
    "alert": {
      "type": "object",
      "allOf": [
        { "$ref": "#/$defs/commonEvent" },
        {
          "type": "object",
          "properties": {
            "id": { "type": "string", "pattern": "^Interaction\\.Event\\.Alert\\." },
            "inherits_from": { "const": "Interaction.Event.Alert" },
            "priority": { "enum": ["critical", "high"] },
            "context_policy": {
              "allOf": [
                { "$ref": "#/$defs/contextPolicy" },
                { "type": "object", "properties": { "on_blocked": { "type": "object", "properties": { "disposition": { "const": "never_block" } } } } }
              ]
            }
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "notification": {
      "type": "object",
      "allOf": [
        { "$ref": "#/$defs/commonEvent" },
        {
          "type": "object",
          "properties": {
            "id": { "type": "string", "pattern": "^Interaction\\.Event\\.Notification\\." },
            "inherits_from": { "const": "Interaction.Event.Notification" }
          }
        }
      ],
      "unevaluatedProperties": false
    }
  }
}
