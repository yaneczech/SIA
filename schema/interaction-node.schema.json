{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/janjanecek/SIA/schema/interaction-node.schema.json",
  "title": "Semantic Interaction Node",
  "description": "Minimal draft schema profile for the declarative metadata contract described by SIA v0.1. This is intended as an implementable subset of a broader ontology language. The choice of formalism (JSON Schema vs OWL/SHACL vs custom) is held open in Section 12 of the position paper — this file is one candidate, not a binding commitment.",
  "type": "object",
  "required": [
    "node",
    "since_version",
    "direction",
    "target_role",
    "inherits_from"
  ],
  "properties": {
    "node": {
      "type": "string",
      "pattern": "^Interaction\\.(Action|Event|State|Task)(\\.[A-Za-z0-9_]+)+$"
    },
    "inherits_from": {
      "type": "string",
      "pattern": "^Interaction(\\.[A-Za-z0-9_]+)+$",
      "description": "Reference to the parent node in the ontology hierarchy. Declaration-time only; not present on runtime instances."
    },
    "since_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "deprecated_since": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "replaced_by": {
      "type": "string"
    },
    "compatible_with_min_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "direction": {
      "enum": ["input", "output", "internal", "composite"],
      "description": "input = Action (user → system); output = Event (system → user); internal = State; composite = Task (multi-step over Actions and States)."
    },
    "temporal_type": {
      "enum": ["discrete", "sustained", "continuous"]
    },
    "recommended_modality": {
      "type": "string"
    },
    "attention_metrics": {
      "type": "object",
      "properties": {
        "glance_time_estimated_ms": {
          "type": "integer",
          "minimum": 0
        },
        "mean_single_glance_ms": {
          "type": "integer",
          "minimum": 0
        },
        "task_steps": {
          "type": "integer",
          "minimum": 0
        },
        "voice_alt_available": {
          "type": "boolean"
        },
        "cognitive_load": {
          "enum": ["minimal", "moderate", "high", "locked_while_driving"]
        }
      },
      "additionalProperties": false
    },
    "priority": {
      "type": "integer",
      "minimum": 0,
      "maximum": 100
    },
    "interruptibility": {
      "type": "boolean"
    },
    "requires_ack": {
      "type": "boolean"
    },
    "ack_kind": {
      "type": "string"
    },
    "ack_timeout_ms": {
      "type": "integer",
      "minimum": 0,
      "description": "Base declarative timeout. Context Policy may scale the effective value at runtime per the modifier whitelist in Section 8."
    },
    "ack_authority": {
      "enum": ["driver_only", "any_occupant", "system"]
    },
    "trust_requirements": {
      "type": "object",
      "properties": {
        "signed_origin_required": {
          "type": "boolean"
        },
        "permitted_actor_classes": {
          "type": "array",
          "items": {
            "enum": [
              "human_direct",
              "human_voice",
              "agent_local",
              "agent_cloud",
              "adas",
              "vsc",
              "service",
              "third_party_app"
            ]
          },
          "uniqueItems": true
        },
        "max_age_ms": {
          "type": "integer",
          "minimum": 0
        },
        "replay_protection": {
          "enum": ["none", "recommended", "required"]
        }
      },
      "additionalProperties": false
    },
    "target_role": {
      "enum": ["driver", "front_passenger", "rear_passenger", "any_occupant", "system_internal"]
    },
    "scope": {
      "type": "string"
    },
    "consistency_class": {
      "enum": ["strong", "eventual", "best_effort"]
    },
    "accessibility_alt": {
      "type": "object",
      "additionalProperties": true
    },
    "regulatory_basis": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "assessment_basis": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "pii_class": {
      "enum": ["none", "personal", "sensitive", "special_category"],
      "description": "Aligned with GDPR vocabulary: personal = Art. 4(1); sensitive = de-facto industry tier between personal and special_category; special_category = Art. 9."
    },
    "temporal_freshness_ms": {
      "type": "integer",
      "minimum": 0
    },
    "suppression_class": {
      "enum": ["safety_critical", "regulated", "system", "user", "third_party"]
    },
    "merges_with": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "fallback_chain": {
      "type": "array",
      "items": {
        "enum": ["hud", "cluster", "ivi", "voice", "haptic", "ar", "steering_wheel"]
      }
    },
    "degradation_policy": {
      "enum": ["escalate", "downgrade", "suppress", "no_degradation"]
    },
    "step_count": {
      "type": "integer",
      "minimum": 1
    },
    "interruptible_at": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "resumable_across_contexts": {
      "type": "boolean"
    }
  },
  "additionalProperties": false
}
