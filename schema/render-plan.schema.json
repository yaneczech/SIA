{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/yaneczech/SIA/schema/v0.4/render-plan.schema.json",
  "title": "SIA Render Plan",
  "type": "object",
  "required": [
    "decision_id",
    "instance_id",
    "context_id",
    "spec_version",
    "profile_version",
    "catalog_version",
    "catalog_sha256",
    "node_schema_sha256",
    "policy_ref",
    "policy_version",
    "policy_sha256",
    "created_at_ms",
    "selected",
    "rejected",
    "delivery_success_policy",
    "delivery_timeout_ms",
    "reason_code"
  ],
  "properties": {
    "decision_id": { "$ref": "#/$defs/uuid" },
    "instance_id": { "$ref": "#/$defs/uuid" },
    "context_id": { "$ref": "#/$defs/uuid" },
    "spec_version": { "const": "0.4.0" },
    "profile_version": { "$ref": "#/$defs/semver" },
    "catalog_version": { "$ref": "#/$defs/semver" },
    "catalog_sha256": { "$ref": "#/$defs/sha256" },
    "node_schema_sha256": { "$ref": "#/$defs/sha256" },
    "policy_ref": { "type": "string", "pattern": "^sia:policy:[a-z0-9_.-]+:[0-9]+$" },
    "policy_version": { "$ref": "#/$defs/semver" },
    "policy_sha256": { "$ref": "#/$defs/sha256" },
    "created_at_ms": { "type": "integer", "minimum": 0 },
    "selected": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "contains": {
        "type": "object",
        "properties": { "role": { "const": "primary" } },
        "required": ["role"]
      },
      "minContains": 1,
      "maxContains": 1,
      "items": {
        "type": "object",
        "required": ["renderer_id", "role"],
        "properties": {
          "renderer_id": { "type": "string", "pattern": "^Renderer\\.[A-Z][A-Za-z0-9_.-]+$" },
          "role": { "enum": ["primary", "required", "concurrent", "fallback"] }
        },
        "additionalProperties": false
      }
    },
    "rejected": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["renderer_id", "reason_code"],
        "properties": {
          "renderer_id": { "type": "string", "pattern": "^Renderer\\.[A-Z][A-Za-z0-9_.-]+$" },
          "reason_code": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]+$" }
        },
        "additionalProperties": false
      }
    },
    "delivery_success_policy": { "enum": ["any_selected_presented", "primary_presented", "all_required_presented"] },
    "delivery_timeout_ms": { "type": "integer", "minimum": 1, "maximum": 60000 },
    "reason_code": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]+$" }
  },
  "additionalProperties": false,
  "$defs": {
    "semver": { "type": "string", "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z.-]+)?$" },
    "uuid": { "type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-8][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$" },
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
  }
}
